DATABASE_URL=
WORKER_CONCURRENCY=2
# Cartella dei file dei brand (default: moonbrand/moonbrand-brands)
BRANDS_DIR=
GEMINI_API_KEY=
# ElevenLabs: voce fuori campo ed effetti sonori.
ELEVENLABS_API_KEY=
# Mureka (platform.mureka.ai): musica strumentale e canzoni.
MUREKA_API_KEY=
# Higgsfield (clip dei video): nessuna chiave, il token si chiede al loro CLI (`higgsfield auth login` una volta sulla macchina).
# HIGGSFIELD_TOKEN scavalca il CLI, per una prova; HIGGSFIELD_CLI se il comando si chiama in un altro modo.
HIGGSFIELD_TOKEN=
HIGGSFIELD_CLI=
HIGGSFIELD_URL=
# Dove i tool della chat chiamano moonbrand-api (default: http://localhost:3012)
API_URL=
