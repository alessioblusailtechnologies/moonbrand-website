---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Examples from '../components/Examples.astro';
import Platform from '../components/Platform.astro';
import Result from '../components/Result.astro';
import Features from '../components/Features.astro';
import TrialForm from '../components/TrialForm.astro';
import Footer from '../components/Footer.astro';
---

<Base
  title="Moonbrand · Crea i tuoi post senza la pagina bianca"
  description="Con Moonbrand crei, organizzi e pianifichi i contenuti social con un’AI che conosce il tuo tone of voice."
>
  <Header />
  <main>
    <Hero />
    <Examples />
    <Platform />
    <Result />
    <Features />
    <TrialForm />
  </main>
  <Footer />
</Base>
