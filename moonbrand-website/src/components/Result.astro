---
import { day, inside } from '../data/home';
---

<section id="risultato" class="result" data-screen-label="Risultato">
  <div class="inner">
    <span class="eyebrow mono">Il risultato</span>
    <h2 class="display h2">Scrivi meno. Pubblichi meglio.</h2>
    <p class="sub">Ogni volta che apri Moonbrand parti da un brand che conosce già: tono, colori, storico. E da una bozza, non da un foglio vuoto.</p>
    <div class="big">0 pagine<br /><span>bianche</span></div>

    <div class="cards">
      <div class="photo">
        <img src="/images/social-manager.jpg" alt="Una social media manager al lavoro con il telefono e il portatile" loading="lazy" />
        <span class="photo-title">Un giorno tipo, con Moonbrand</span>
      </div>

      <div class="timeline">
        {day.map((d) => (
          <div class="moment">
            <span class="mono">{d.h}</span>
            <span class="moment-text">{d.t}</span>
          </div>
        ))}
      </div>

      <div class="inside">
        <span class="inside-title">Cosa trovi dentro</span>
        <span class="inside-sub">Per ogni brand che gestisci</span>
        {inside.map((i) => (
          <div class="row"><span>{i.k}</span><strong>{i.v}</strong></div>
        ))}
        <div class="inside-ctas">
          <a href="#prova" class="btn btn-dark">Inizia la prova</a>
          <a href="#sistema" class="btn btn-line">Scopri le funzionalità</a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .result { background: var(--ink); color: #fff; padding: clamp(96px, 11vw, 150px) 24px; }
  .inner { max-width: 1100px; margin: 0 auto; display: flex; flex-direction: column; align-items: center; gap: 22px; }
  .eyebrow { font-size: 12px; color: #7E8AA3; text-transform: uppercase; letter-spacing: 0.08em; }
  h2 { max-width: 760px; }
  .sub { margin: 0; font-size: 16.5px; line-height: 1.5; color: #AEB7C8; text-align: center; max-width: 540px; }
  .big {
    font-family: var(--display);
    font-stretch: 62%;
    font-weight: 900;
    font-size: clamp(96px, 17vw, 230px);
    line-height: 0.85;
    letter-spacing: -0.02em;
    text-align: center;
    margin: 28px 0 40px;
  }
  .big span { color: var(--accent); }

  .cards { width: 100%; display: flex; flex-wrap: wrap; gap: 12px; }
  .photo {
    position: relative;
    flex: 1 1 280px;
    min-height: 380px;
    border-radius: 16px;
    overflow: hidden;
    background: #131D33;
    border: 1px solid #1C2640;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 22px;
  }
  .photo img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .photo::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 55%, rgba(11, 19, 36, 0.85) 100%);
  }
  .photo-title { position: relative; z-index: 1; font-size: 14px; font-weight: 600; }

  .timeline { flex: 1 1 280px; display: flex; flex-direction: column; gap: 12px; }
  .moment { flex: 1; background: #131C30; border: 1px solid #1C2640; border-radius: 16px; padding: 22px; display: flex; flex-direction: column; gap: 12px; }
  .moment .mono { font-size: 12px; color: var(--accent); }
  .moment-text { font-size: 15.5px; line-height: 1.55; color: #E4E7EC; }

  .inside { flex: 1 1 300px; background: var(--accent); color: #1A1204; border-radius: 16px; padding: 24px; display: flex; flex-direction: column; gap: 6px; }
  .inside-title { font-family: var(--display); font-stretch: 70%; font-weight: 800; font-size: 28px; letter-spacing: -0.01em; }
  .inside-sub { font-size: 13.5px; margin-bottom: 12px; color: #3D2A0C; }
  .row { display: flex; justify-content: space-between; gap: 12px; padding: 9px 0; border-top: 1px solid rgba(26, 18, 4, 0.15); font-size: 14.5px; }
  .row strong { font-weight: 600; }
  .inside-ctas { display: flex; flex-direction: column; gap: 8px; margin-top: auto; padding-top: 18px; }
  .inside-ctas .btn { font-size: 14.5px; padding: 12px; }
  .inside-ctas .btn-line { font-weight: 500; border: 1px solid #1A1204; padding: 11px; }
  .inside-ctas .btn-line:hover { color: #1A1204; background: rgba(26, 18, 4, 0.08); }
</style>
