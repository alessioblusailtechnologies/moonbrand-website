---
// Tre schermate di Moonbrand Studio (chat, idee, contenuti) dentro la sua cornice, con il brand Solco.
// Struttura, misure e colori vengono da moonbrand-studio: shell.ts, chat-page, ideas-page, contents-page e styles.scss.
import {
  studioChat,
  studioContents,
  studioHistory,
  studioIdeas,
  studioIdeasThemes,
  studioNav,
  studioViews,
} from '../data/home';
import StudioIcon from './studio/StudioIcon.astro';

const initial = studioViews[0];

// La griglia dei contenuti è a colonne come nello studio: ogni card va nella colonna più bassa.
const contentColumns: (typeof studioContents)[] = [[], [], []];
const heights = [0, 0, 0];
for (const content of studioContents) {
  const [w, h] = content.aspect.split(' / ').map(Number);
  const i = heights.indexOf(Math.min(...heights));
  contentColumns[i].push(content);
  heights[i] += h / w + 0.45;
}
const ideaColumns = [studioIdeas.filter((_, i) => i % 2 === 0), studioIdeas.filter((_, i) => i % 2 === 1)];
---

<section id="piattaforma" class="platform" data-screen-label="Piattaforma">
  <div class="inner">
    <h2 class="display h2">Semplifica la gestione dei tuoi social</h2>
    <p class="sub">Idee, post, caroselli e brand kit in un unico posto. Per un brand o per dieci.</p>

    <div class="tabs" role="tablist" aria-label="Schermate di Moonbrand Studio">
      {studioViews.map((v) => (
        <button type="button" role="tab" class="tab" data-view={v.id} data-nav={v.nav} aria-selected={v.id === initial.id ? 'true' : 'false'}>
          {v.label}
        </button>
      ))}
    </div>

    <div class="studio" inert>
      <aside class="sidebar">
        <div class="head">
          <span class="logo"><span class="moon"></span><span class="word">Moonbrand <span class="studio-word">Studio</span></span></span>
          <span class="side-btn"><StudioIcon name="panel-left" stroke={1.8} /></span>
        </div>

        <div class="switcher">
          <span class="avatar">SO</span>
          <span class="switcher-text">
            <span class="switcher-name">Solco</span>
            <span class="switcher-kind">Elettronica di consumo</span>
          </span>
          <StudioIcon name="chevrons-up-down" size={16} class="muted-icon" />
        </div>

        <div class="quick">
          <span class="new-chat"><StudioIcon name="plus" size={16} stroke={2.2} /><span>Nuova chat</span></span>
          <span class="side-btn search"><StudioIcon name="search" size={16} /></span>
        </div>

        <nav class="nav">
          {studioNav.map((item) => (
            <span class:list={['nav-item', { active: item.label === initial.nav }]} data-nav-item={item.label}>
              <StudioIcon name={item.icon} stroke={1.8} />
              <span class="nav-label">{item.label}</span>
            </span>
          ))}
        </nav>

        <div class="history">
          {studioHistory.map((group, g) => (
            <div class="group">
              <p class="group-label">{group.label}</p>
              {group.items.map((item, i) => (
                <span class:list={['session', { active: g === 0 && i === 0 }]}>{item}</span>
              ))}
            </div>
          ))}
        </div>

        <div class="foot">
          <span class="nav-item"><StudioIcon name="settings" stroke={1.8} /><span class="nav-label">Impostazioni brand</span></span>
          <div class="account">
            <span class="initials">EC</span>
            <span class="account-texts">
              <span class="account-name">Elena Conti</span>
              <span class="account-email">elena@solco.tech</span>
            </span>
            <span class="side-btn"><StudioIcon name="log-out" size={16} /></span>
          </div>
        </div>
      </aside>

      <div class="main">
        {studioViews.map((v) => (
          <header class="topbar" data-panel={v.id} hidden={v.id !== initial.id}>
            <nav class="crumbs">
              {v.crumbs.map((crumb, i) => (
                <>
                  {i > 0 && <span class="crumb-sep">/</span>}
                  <span class:list={['crumb', { current: i === v.crumbs.length - 1 }]}>{crumb}</span>
                </>
              ))}
            </nav>
            <div class="page-actions">
              {v.id === 'chat' && (
                <>
                  <span class="kit"><span class="kit-dot"></span> Brand kit attivo</span>
                  <span class="icon-btn"><StudioIcon name="trash" size={18} /></span>
                </>
              )}
              {v.id === 'idee' && <span class="btn btn-primary btn-sm">Proponi altre idee</span>}
              {v.id === 'contenuti' && <span class="btn btn-secondary btn-sm">Crea da un’idea</span>}
            </div>
          </header>
        ))}

        <!-- La chat: la foto e la richiesta, i passaggi, la risposta e il contenuto salvato; in fondo la casella. -->
        <div class="content chat" data-panel="chat" hidden={initial.id !== 'chat'}>
          <div class="thread">
            <div class="turn">
              <div class="photos"><img class="photo" src={studioChat.photo} alt="" loading="lazy" /></div>
              <p class="mine">{studioChat.message}</p>
              <div class="reply">
                <div class="tools">
                  <span class="mark done"><StudioIcon name="check" size={12} stroke={3} /></span>
                  <span class="strong-sm grow">{studioChat.steps.title}</span>
                  <span class="caption">{studioChat.steps.time}</span>
                  <StudioIcon name="chevron-down" size={16} class="muted-icon" />
                </div>
                <p class="answer">{studioChat.reply}</p>
                <article class="content-card">
                  <header class="content-card-head">
                    <div class="content-card-titles">
                      <div class="badges">
                        <span class="badge">{studioChat.content.format}</span>
                        <span class="badge">{studioChat.content.status}</span>
                      </div>
                      <h3 class="strong">{studioChat.content.title}</h3>
                    </div>
                    <span class="btn btn-secondary btn-sm">Apri in Contenuti <StudioIcon name="chevron-right" size={14} /></span>
                  </header>
                  <div class="preview">
                    <img src={studioChat.content.cover} alt="" loading="lazy" />
                    <div class="preview-text">
                      <span class="label">{studioChat.content.channels}</span>
                      <p class="body ink"><strong>solco.tech</strong> {studioChat.content.caption}</p>
                    </div>
                  </div>
                </article>
              </div>
            </div>
          </div>
          <div class="composer">
            <span class="composer-input">Rispondi all’assistente…</span>
            <div class="composer-bar">
              <span class="attach"><StudioIcon name="paperclip" size={16} stroke={1.8} /> Allega</span>
              <span class="grow"></span>
              <span class="icon-btn"><StudioIcon name="mic" /></span>
              <span class="icon-btn send"><StudioIcon name="arrow-up" /></span>
            </div>
          </div>
        </div>

        <!-- Le idee: proposte e salvate, i temi del brand, le card con il perché adesso. -->
        <div class="content ideas" data-panel="idee" hidden={initial.id !== 'idee'}>
          <div class="toolbar">
            <div class="segmented">
              <span class="selected">Proposte · 8</span>
              <span>Salvate · 3</span>
            </div>
            <div class="filters">
              {studioIdeasThemes.map((theme, i) => <span class:list={['chip', { selected: i === 0 }]}>{theme}</span>)}
            </div>
          </div>
          <div class="grid">
            {ideaColumns.map((column) => (
              <div class="column">
                {column.map((idea) => (
                  <article class="panel idea">
                    <div class="meta">
                      <span class="badge">{idea.signal}</span>
                      <span class="theme caption"><span class="dot" style={`background:${idea.theme.color}`}></span>{idea.theme.name}</span>
                    </div>
                    <div class="stack">
                      <p class="label">{idea.angleLabel}</p>
                      <h3 class="heading">{idea.title}</h3>
                    </div>
                    <p class="body">{idea.angle}</p>
                    <div class="why">
                      <p class="label">Perché adesso</p>
                      <p class="body ink">{idea.why}</p>
                    </div>
                    <div class="actions">
                      <span class="btn btn-secondary btn-sm">Scarta</span>
                      <span class="btn btn-secondary btn-sm">Salva</span>
                      <span class="btn btn-primary btn-sm">Crea contenuto</span>
                    </div>
                  </article>
                ))}
              </div>
            ))}
          </div>
        </div>

        <!-- I contenuti: la griglia a colonne con copertina, formato, stato e canali. -->
        <div class="content contents" data-panel="contenuti" hidden={initial.id !== 'contenuti'}>
          <div class="grid">
            {contentColumns.map((column) => (
              <div class="column">
                {column.map((content) => (
                  <article class="panel card">
                    <div class="cover" style={`aspect-ratio:${content.aspect}`}>
                      {content.cover ? (
                        <>
                          <img src={content.cover} alt="" loading="lazy" />
                          {content.video && <span class="play"><StudioIcon name="play" size={18} /></span>}
                        </>
                      ) : (
                        <span class="caption preparing"><span class="spinner"></span> Preparo il video…</span>
                      )}
                    </div>
                    <div class="badges">
                      <span class="badge">{content.format}</span>
                      <span class:list={['badge', { mint: content.status === 'Approvato' }]}>{content.status}</span>
                    </div>
                    <h3 class="strong">{content.title}</h3>
                    <p class="caption">{content.channels}</p>
                  </article>
                ))}
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const tabs = document.querySelectorAll<HTMLButtonElement>('.platform [data-view]');
  const panels = document.querySelectorAll<HTMLElement>('.platform [data-panel]');
  const navItems = document.querySelectorAll<HTMLElement>('.platform [data-nav-item]');

  tabs.forEach((tab) =>
    tab.addEventListener('click', () => {
      tabs.forEach((t) => t.setAttribute('aria-selected', String(t === tab)));
      panels.forEach((p) => (p.hidden = p.dataset.panel !== tab.dataset.view));
      navItems.forEach((n) => n.classList.toggle('active', n.dataset.navItem === tab.dataset.nav));
    }),
  );
</script>

<style>
  .platform { padding: 0 24px 140px; }
  .inner { max-width: 1180px; margin: 0 auto; display: flex; flex-direction: column; align-items: center; gap: 28px; }
  h2 { max-width: 780px; }
  .sub { margin: 0; font-size: 16.5px; line-height: 1.5; color: var(--muted); text-align: center; max-width: 560px; }

  .tabs { display: flex; gap: 6px; flex-wrap: wrap; justify-content: center; margin-top: 8px; }
  .tab {
    font-family: inherit;
    font-size: 14px;
    font-weight: 500;
    border: 1px solid #E4E4E0;
    border-radius: 999px;
    padding: 8px 16px;
    cursor: pointer;
    background: #fff;
    color: var(--text);
  }
  .tab[aria-selected='true'] { background: var(--ink); border-color: var(--ink); color: #fff; }

  /* La palette di moonbrand-studio/src/styles.scss */
  .studio {
    --primary: #0b1324;
    --primary-soft: #26324a;
    --accent: #f29a2e;
    --accent-strong: #c96f10;
    --grey-100: #f1efea;
    --grey-300: #d4d2cc;
    --grey-500: #98a2b3;
    --mint-400: #6dd47e;
    --success: #2f9e6a;
    --surface-app: #fafaf8;
    --sidebar-text: #c4ccda;
    --sidebar-muted: #7e8aa3;
    --text-title: #0b1324;
    --text-body: #667085;
    --border-subtle: #ededea;
    --border-card: #e9e8e4;
    --ease: cubic-bezier(0.2, 0, 0.2, 1);

    display: flex;
    width: 100%;
    height: 680px;
    overflow: hidden;
    border-radius: 20px;
    background: var(--primary);
    box-shadow: 0 40px 80px -40px rgba(11, 19, 36, 0.55);
    color: var(--text-title);
    font-size: 14px;
    line-height: 1.5;
    text-align: left;
  }
  .studio p, .studio h3 { margin: 0; }

  /* La sidebar: shell.ts */
  .sidebar {
    display: flex;
    flex: none;
    flex-direction: column;
    gap: 6px;
    width: 248px;
    padding: 14px 12px;
    overflow: hidden;
    color: var(--sidebar-text);
  }
  .head { display: flex; align-items: center; justify-content: space-between; gap: 8px; min-height: 40px; padding: 4px 6px 10px; }
  .logo { display: inline-flex; align-items: center; gap: 10px; color: #fff; font-size: 16px; font-weight: 600; letter-spacing: -0.01em; white-space: nowrap; }
  .moon { position: relative; flex: none; width: 26px; height: 26px; overflow: hidden; border-radius: 50%; background: var(--accent); }
  .moon::after { content: ''; position: absolute; top: -3px; left: -7px; width: 22px; height: 22px; border-radius: 50%; background: var(--primary); }
  .studio-word { font-weight: 500; opacity: 0.55; }
  .side-btn { display: grid; flex: none; place-items: center; width: 30px; height: 30px; border-radius: 8px; color: var(--sidebar-muted); }
  .switcher {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.04);
    color: #fff;
  }
  .avatar { display: grid; place-items: center; flex: none; width: 32px; height: 32px; border-radius: 8px; background: #111; color: #fff; font-size: 12px; font-weight: 700; }
  .switcher-text { display: flex; flex: 1; flex-direction: column; min-width: 0; line-height: 1.3; }
  .switcher-name { font-size: 14px; font-weight: 600; }
  .switcher-kind { color: var(--sidebar-muted); font-size: 12px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .muted-icon { color: var(--sidebar-muted); flex: none; }
  .quick { display: flex; gap: 6px; margin-top: 8px; }
  .new-chat {
    display: flex;
    flex: 1;
    align-items: center;
    justify-content: center;
    gap: 8px;
    height: 38px;
    border-radius: 10px;
    background: var(--accent);
    color: #1a1204;
    font-size: 14px;
    font-weight: 600;
    white-space: nowrap;
  }
  .search { width: 38px; height: 38px; border-radius: 10px; background: rgba(255, 255, 255, 0.06); color: var(--sidebar-text); }
  .nav { display: flex; flex-direction: column; gap: 2px; margin-top: 14px; }
  .nav-item { display: flex; align-items: center; gap: 12px; height: 38px; padding: 0 12px; border-radius: 10px; font-size: 14px; font-weight: 500; white-space: nowrap; }
  .nav-item.active { background: rgba(255, 255, 255, 0.09); color: #fff; }
  .history { display: flex; flex: 1; flex-direction: column; gap: 14px; min-height: 0; margin-top: 18px; overflow: hidden; }
  .group { display: flex; flex-direction: column; gap: 1px; }
  .group-label { padding: 0 12px 6px; color: #5e6a82; font-size: 11px; font-weight: 500; letter-spacing: 0.06em; text-transform: uppercase; }
  .session { display: block; height: 34px; padding: 0 12px; line-height: 34px; border-radius: 8px; color: #9aa5ba; font-size: 13.5px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .session.active { background: rgba(255, 255, 255, 0.07); color: #fff; }
  .foot { display: flex; flex-direction: column; gap: 2px; padding-top: 8px; border-top: 1px solid rgba(255, 255, 255, 0.07); }
  .account { display: flex; align-items: center; gap: 10px; padding: 8px 6px; }
  .initials { display: grid; flex: none; place-items: center; width: 30px; height: 30px; border-radius: 50%; background: var(--primary-soft); color: #fff; font-size: 12px; font-weight: 600; }
  .account-texts { display: flex; flex: 1; flex-direction: column; min-width: 0; line-height: 1.35; }
  .account-name { color: #fff; font-size: 13px; font-weight: 500; }
  .account-email { color: var(--sidebar-muted); font-size: 12px; overflow: hidden; text-overflow: ellipsis; }

  /* Il pannello avorio con la barra in alto */
  .main {
    display: flex;
    flex: 1;
    flex-direction: column;
    min-width: 0;
    margin: 8px 8px 8px 0;
    overflow: hidden;
    border-radius: 16px;
    background: var(--surface-app);
  }
  .topbar { display: flex; flex: none; align-items: center; gap: 16px; height: 56px; padding: 0 24px; border-bottom: 1px solid var(--border-subtle); }
  .crumbs { display: flex; flex: 1; align-items: center; gap: 8px; min-width: 0; font-size: 14px; }
  .crumb { color: var(--text-body); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .crumb.current { color: var(--text-title); font-weight: 500; }
  .crumb-sep { color: #c8ccd4; }
  .page-actions { display: flex; flex: none; align-items: center; gap: 8px; }
  .kit { display: inline-flex; align-items: center; gap: 6px; padding: 6px 10px; border-radius: 999px; background: var(--grey-100); color: #475467; font-size: 12.5px; white-space: nowrap; }
  .kit-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--success); }
  .content { flex: 1; min-height: 0; padding: 24px 28px; overflow: hidden; }
  .content.ideas, .content.contents {
    overflow-y: auto;
    scrollbar-width: none;
    mask-image: linear-gradient(180deg, #000 calc(100% - 48px), transparent);
  }

  /* I pezzi comuni: styles.scss */
  .strong { font-size: 14px; font-weight: 600; line-height: 1.35; }
  .strong-sm { font-size: 13px; font-weight: 600; line-height: 1.35; }
  .heading { font-size: 19px; font-weight: 600; line-height: 1.22; letter-spacing: -0.025em; }
  .body { font-size: 14px; color: var(--text-body); line-height: 1.6; }
  .caption { font-size: 12px; color: var(--text-body); line-height: 1.55; }
  .label { font-size: 11px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-body); }
  .ink { color: var(--text-title); }
  .grow { flex: 1; min-width: 0; }
  .stack { display: flex; flex-direction: column; gap: 12px; }
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    border: 1.5px solid transparent;
    border-radius: 999px;
    font-weight: 500;
    white-space: nowrap;
  }
  .btn-sm { min-height: 32px; padding: 0 14px; font-size: 12px; }
  .btn-primary { background: var(--primary); color: #fff; }
  .btn-secondary { background: #fff; border-color: var(--primary); color: var(--primary); }
  .icon-btn { display: inline-flex; align-items: center; justify-content: center; width: 36px; height: 36px; border-radius: 999px; color: var(--primary); }
  .panel { display: flex; flex-direction: column; gap: 12px; padding: 20px; border: 1px solid var(--border-card); border-radius: 20px; background: #fff; }
  .badges { display: flex; flex-wrap: wrap; gap: 6px; }
  .badge { display: inline-flex; align-items: center; align-self: flex-start; min-height: 22px; padding: 0 10px; border-radius: 999px; background: var(--grey-100); color: var(--text-title); font-size: 11px; font-weight: 600; }
  .badge.mint { background: rgba(109, 212, 126, 0.25); }
  .dot { display: inline-block; flex: none; width: 10px; height: 10px; border-radius: 50%; }
  .spinner { display: inline-block; width: 12px; height: 12px; border: 2px solid currentColor; border-right-color: transparent; border-radius: 50%; animation: spin 700ms linear infinite; }
  @keyframes spin { to { transform: rotate(360deg); } }

  /* La chat: chat-page.scss e composer.scss */
  .chat { display: flex; flex-direction: column; gap: 10px; }
  .thread {
    flex: 1;
    min-height: 0;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    mask-image: linear-gradient(180deg, transparent, #000 56px);
  }
  .turn { display: flex; flex-direction: column; gap: 10px; width: min(760px, 100%); margin: 0 auto; }
  .photos { align-self: flex-end; }
  .photo { display: block; width: 96px; height: 96px; border-radius: 12px; object-fit: cover; background: var(--grey-100); }
  .mine {
    align-self: flex-end;
    max-width: 80%;
    padding: 10px 16px;
    border-radius: 16px 16px 4px 16px;
    background: var(--primary);
    color: #fff;
    line-height: 1.55;
  }
  .reply { display: flex; flex-direction: column; gap: 10px; margin-top: 4px; }
  .tools { display: flex; align-items: center; gap: 10px; width: min(560px, 100%); padding: 12px 14px; border: 1px solid var(--border-card); border-radius: 16px; }
  .tools .muted-icon { color: var(--text-body); }
  .mark { display: inline-flex; align-items: center; justify-content: center; flex: none; width: 20px; height: 20px; border-radius: 50%; }
  .mark.done { background: var(--mint-400); color: #fff; }
  .answer { color: var(--text-title); line-height: 1.6; }
  .content-card { display: flex; flex-direction: column; gap: 14px; margin-top: 4px; padding: 16px; border: 1px solid var(--border-card); border-radius: 16px; background: #fff; }
  .content-card-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 16px; }
  .content-card-titles { display: flex; flex-direction: column; gap: 8px; min-width: 0; }
  .preview { display: flex; gap: 14px; align-items: flex-start; }
  .preview img { flex: none; width: 92px; aspect-ratio: 4 / 5; border-radius: 10px; object-fit: cover; }
  .preview-text { display: flex; flex-direction: column; gap: 6px; min-width: 0; }
  .preview-text .body { font-size: 13.5px; line-height: 1.5; }
  .composer {
    display: flex;
    flex-direction: column;
    gap: 8px;
    width: min(760px, 100%);
    margin: 0 auto;
    padding: 14px 16px 12px;
    border: 1px solid #e4e4e0;
    border-radius: 20px;
    background: #fff;
    box-shadow: 0 1px 2px rgba(11, 19, 36, 0.04), 0 8px 24px -8px rgba(11, 19, 36, 0.08);
  }
  .composer-input { padding: 4px 4px 6px; color: var(--grey-500); font-size: 15px; }
  .composer-bar { display: flex; align-items: center; gap: 6px; }
  .attach { display: inline-flex; align-items: center; gap: 7px; height: 34px; padding: 0 12px; border: 1px solid #e4e4e0; border-radius: 999px; color: #344054; font-size: 13px; font-weight: 500; }
  .send { background: #eaecf0; color: var(--grey-500); }

  /* Le idee: ideas-page.scss */
  .ideas { display: flex; flex-direction: column; gap: 20px; }
  .toolbar { display: flex; align-items: center; gap: 12px; min-width: 0; }
  .segmented { display: flex; flex: none; width: 230px; padding: 3px; border-radius: 999px; background: #fff; border: 1px solid var(--border-card); }
  .segmented span { flex: 1; display: grid; place-items: center; min-height: 28px; border-radius: 999px; color: var(--text-body); font-size: 12px; font-weight: 500; }
  .segmented .selected { background: var(--primary); color: #fff; }
