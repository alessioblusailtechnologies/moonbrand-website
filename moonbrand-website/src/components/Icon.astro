interface Props {
  name: keyof typeof paths;
  size?: number;
  fill?: boolean;
  class?: string;
}

const { name, size = 22, fill = false, class: className } = Astro.props;
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill={fill ? 'currentColor' : 'none'}
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  aria-hidden="true"
  set:html={paths[name]}
/>
